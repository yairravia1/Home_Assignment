## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Rider
.idea/

# Visual Studio Code
.vscode/

# Secrets and sensitive files
appsettings.Production.json
appsettings.*.Local.json
.env
.env.local
.env.production
secrets.json

# User Secrets
**/appsettings.*.json
!**/appsettings.json
!**/appsettings.Development.json

# OS files
.DS_Store
Thumbs.db

# Test results
TestResults/
*.trx
*.coverage
